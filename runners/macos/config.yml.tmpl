# Forgejo Runner — macOS host-mode config (runners/macos/)
# Rendered by install.sh from this template; keys per v12 config schema.
log:
  level: info

runner:
  file: @STATE_DIR@/.runner
  capacity: @CAPACITY@
  timeout: 30m
  fetch_timeout: 5s
  fetch_interval: 2s
  report_interval: 1s
  labels:
    - @LABELS@

cache:
  enabled: true
  dir: @STATE_DIR@/cache

# Host-schema jobs ignore the container section; kept for future
# docker:// labels (e.g. via Colima) so switching schemas needs no rewrite.
container:
  network: ""
  privileged: false
  options: ""
  workdir_parent: @STATE_DIR@/work
  valid_volumes: []

host:
  workdir_parent: @STATE_DIR@/work
