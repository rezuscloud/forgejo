# Custom Forgejo 16 release metadata used by .github/workflows/forgejo-release.yml.
# Upstream helm-chart 17.x still targets Forgejo 15.x, so we ship a vendored
# chart (18.0.0-rc.1) and a custom multi-arch image built from the rezuscloud
# Forgejo fork branch that already carries the v16-only Actions logs API.
FORGEJO_SOURCE_REPOSITORY=rezuscloud/forgejo
FORGEJO_SOURCE_REF=forgejo
FORGEJO_RELEASE_VERSION=16.0.0-rc.1
FORGEJO_CHART_VERSION=18.0.0-rc.1
FORGEJO_IMAGE_REPOSITORY=ghcr.io/rezuscloud/forgejo
FORGEJO_CHART_OCI_REPOSITORY=oci://ghcr.io/rezuscloud/charts
