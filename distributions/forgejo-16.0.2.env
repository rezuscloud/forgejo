# Custom Forgejo 16.0.2 release metadata for .github/workflows/release.yml.
# Fork re-based onto upstream Forgejo v16.0.2 (codeberg/forgejo v16.0.2) +
# rezuscloud additive customizations (Go API SDK, fj CLI, vendored chart).
# Image is a custom multi-arch build from the rezuscloud Forgejo fork.
FORGEJO_SOURCE_REPOSITORY=rezuscloud/forgejo
FORGEJO_SOURCE_REF=rezus/forgejo
FORGEJO_RELEASE_VERSION=16.0.2-rezuscloud.2
FORGEJO_CHART_VERSION=18.0.0-rc.1
FORGEJO_IMAGE_REPOSITORY=ghcr.io/rezuscloud/forgejo
FORGEJO_CHART_OCI_REPOSITORY=oci://ghcr.io/rezuscloud/charts
