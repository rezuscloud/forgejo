                "timeStr(DueOn)"
              ],
              "unlessEmpty": "due_on"
            },
            {
              "format": "Issues: %d open / %d closed\n",
              "columns": [
                "OpenIssues",
                "ClosedIssues"
              ]
            },
            {
              "format": "\n%s\n",
              "columns": [
                "Description"
              ],
              "unlessEmpty": "description"
            }
          ]
        },
        {
          "name": "create",
          "short": "Create a new milestone",
          "op": "issueCreateMilestone",
          "body": {
            "title": {
              "flag": "title",
              "short": "t",
              "required": true,
              "help": "milestone title (required)"
            },
            "description": {
              "flag": "description",
              "short": "d",
              "help": "milestone description"
            },
            "due_on": {
              "flag": "due",
              "help": "due date (RFC3339)"
            }
          },
          "lines": [
            {
              "format": "Created #%d: %s\n",
              "columns": [
                "Id",
                "Title"
              ]
            }
          ]
        },
        {
          "name": "edit",
          "short": "Edit a milestone",
          "use": "edit <ID>",
          "op": "issueEditMilestone",
          "args": [
            {
              "name": "id",
              "use": "<ID>"
            }
          ],
          "body": {
            "title": {
              "flag": "title",
              "short": "t",
              "help": "new milestone title"
            },
            "description": {
              "flag": "description",
              "short": "d",
              "help": "new milestone description"
            },
            "state": {
              "flag": "state",
              "help": "milestone state (open/closed)"
            },
            "due_on": {
              "flag": "due",
              "help": "due date (RFC3339)"
            }
          },
          "lines": [
            {
              "format": "Updated #%d: %s\n",
              "columns": [
                "Id",
                "Title"
              ]
            }
          ]
        },
        {
          "name": "close",
          "short": "Close a milestone",
