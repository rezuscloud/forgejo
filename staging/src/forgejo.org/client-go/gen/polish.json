            "name": {
              "flag": "name",
              "help": "filter by milestone title"
            }
          },
          "consts": {
            "page": 1,
            "limit": 20
          },
          "empty": "no milestones",
          "row": {
            "format": "#%d %s [%s] %s\n",
            "columns": [
              "Id",
              "statusSymbol(stateStr(State))",
              "stateStr(State)",
              "Title"
            ]
          }
        },
        {
          "name": "view",
          "short": "View a milestone",
          "use": "view <ID>",
          "op": "issueGetMilestone",
          "args": [
            {
              "name": "id",
              "use": "<ID>"
            }
          ],
          "lines": [
            {
              "format": "#%d %s\n",
              "columns": [
                "Id",
                "Title"
              ]
